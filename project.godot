[internationalization]

locale/translations=PackedStringArray("res://lang/translations.en.translation")

[layer_names]

3d_render/layer_1="World"
3d_render/layer_3="StaticProp"
3d_render/layer_4="Room"
3d_render/layer_5="Viewmodel"
3d_render/layer_6="LocalPlayer"
3d_render/layer_7="Portal"
3d_physics/layer_1="World"
3d_physics/layer_2="Player"
3d_physics/layer_3="Item"
3d_physics/layer_4="Room"
3d_physics/layer_5="Hitbox"
3d_physics/layer_6="Bounds"
3d_physics/layer_8="Prop"
3d_physics/layer_9="Interact"
3d_physics/layer_10="Viewmodel"

[navigation]

baking/use_crash_prevention_checks=false

[physics]

3d/physics_engine="Jolt Physics"
common/enable_object_picking=false

[rendering]

rendering_device/fallback_to_d3d12=false
rendering_device/fallback_to_opengl3=false
viewport/hdr_2d=true
anti_aliasing/quality/use_debanding=true
limits/opengl/max_renderable_lights=256
limits/opengl/max_lights_per_object=64
occlusion_culling/use_occlusion_culling=true
renderer/rendering_method.opengl="gl_compatibility"
renderer/rendering_method.vulkan="mobile"

[steam]

initialization/app_id=0
initialization/initialize_on_startup=false
initialization/embed_callbacks=false
multiplayer_peer/max_channels=4

[xr]

openxr/startup_alert=false
shaders/enabled=true
